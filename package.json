{
  "name": "@indracorp/darkglass",
  "version": "0.1.0",
  "description": "Sdílená UI knihovna — tokeny a komponenty z návrhu darkglass. Používají ji aplikace AppFactory (CashRegister Admin i Pokladna, dál InvoiceHub a další).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./label": {
      "types": "./src/label/index.d.ts",
      "default": "./src/label/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "showcase": "vite showcase"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
